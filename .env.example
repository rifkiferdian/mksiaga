APP_NAME=MK Siaga
HTTP_ADDR=127.0.0.1:8080
GIN_MODE=debug
SESSION_SECRET=change-this-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
# Kunci khusus enkripsi NIK BLMKC. Gunakan minimal 32 karakter dan jangan diganti setelah data tersimpan.
BLMKC_DATA_KEY=change-this-blmkc-data-key-with-32-characters
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# Set true setelah membuat database development MySQL.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mksiaga_dev
DB_USER=root
DB_PASSWORD=
